# OS / editor
.DS_Store

# Python
__pycache__/
*.pyc

# Machine-specific Claude Code permissions
.claude/settings.local.json

# Workspace pointer — a one-line file holding this machine's absolute
# $JOBISSIMO_HOME path, written by `/sync init`. Per-machine, never committed.
.jobissimo

# ---------------------------------------------------------------------------
# PERSONAL DATA — the one rule that matters.
# Everything personal lives under profile/ (the $JOBISSIMO_HOME workspace) and
# config/ (this install's identity and targets). Both are gitignored entirely;
# the shipped *.example.yaml templates live in templates/config/ (committed).
# ---------------------------------------------------------------------------
/profile/
/config/*.yaml
!/config/*.example.yaml
