# OS / editor
.DS_Store

# Python
__pycache__/
*.pyc

# Machine-specific Claude Code permissions
.claude/settings.local.json

# Workspace pointer — a one-line file holding this machine's absolute
# $JOBISSIMO_HOME path, written by `/sync init`. Per-machine, never committed.
.jobissimo

# ---------------------------------------------------------------------------
# PERSONAL DATA — the one rule that matters.
# Everything personal lives in the workspace ($JOBISSIMO_HOME): knowledge,
# positioning, artefacts, AND this install's config/. The workspace is the
# user's own private git repo (see docs/sync.md), never committed here. The
# `/profile/` entry covers the default in-repo layout; a relocated workspace
# lives outside the repo entirely (found via the .jobissimo pointer above).
# Shipped config templates live in templates/config/ (committed).
# ---------------------------------------------------------------------------
/profile/
